<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!--
    One row of the "Items to AutoMail" table. Declared in XML rather than
    built in Lua because ScrollBox resolves an element template's frame type
    and default extent through C_XMLUtil.GetTemplateInfo, which only knows
    about XML-declared templates.

    The row is a Button so it gets a hover highlight and can accept a dragged
    item. Right-hand widgets anchor to the row's RIGHT edge so the layout
    survives ScrollBox stretching rows to the scroll target's width.
  -->
  <Button name="AutoMailerItemRowTemplate" virtual="true">
    <Size x="280" y="26"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Stripe" setAllPoints="true">
          <Color r="1" g="1" b="1" a="0.05"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <!-- Anchored in Lua: the Recipient edit box it points at is declared
             below, and XML anchors resolve in document order. -->
        <FontString parentKey="RecipientHint" inherits="GameFontDisableSmall" justifyH="LEFT">
          <Size x="80" y="12"/>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button parentKey="IconButton">
        <Size x="20" y="20"/>
        <Anchors>
          <Anchor point="LEFT" x="4" y="0"/>
        </Anchors>
        <NormalTexture parentKey="Icon"/>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
      </Button>
      <EditBox parentKey="Name" inherits="InputBoxTemplate" autoFocus="false">
        <Size x="90" y="20"/>
        <Anchors>
          <Anchor point="LEFT" relativeKey="$parent.IconButton" relativePoint="RIGHT" x="10" y="0"/>
        </Anchors>
      </EditBox>
      <!-- How many of this item to leave in the bags instead of mailing (#78). -->
      <EditBox parentKey="Retain" inherits="InputBoxTemplate" autoFocus="false" numeric="true">
        <Size x="30" y="20"/>
        <Anchors>
          <Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="RIGHT" x="8" y="0"/>
        </Anchors>
      </EditBox>
      <EditBox parentKey="Recipient" inherits="InputBoxTemplate" autoFocus="false">
        <Size x="80" y="20"/>
        <Anchors>
          <Anchor point="LEFT" relativeKey="$parent.Retain" relativePoint="RIGHT" x="8" y="0"/>
        </Anchors>
      </EditBox>
      <Button parentKey="Delete">
        <Size x="16" y="16"/>
        <Anchors>
          <Anchor point="RIGHT" x="-6" y="0"/>
        </Anchors>
        <NormalTexture file="Interface\Buttons\UI-GroupLoot-Pass-Up"/>
        <PushedTexture file="Interface\Buttons\UI-GroupLoot-Pass-Down"/>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
      </Button>
    </Frames>
    <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD">
      <Color r="1" g="1" b="1" a="0.15"/>
    </HighlightTexture>
  </Button>

  <!--
    One row of the "Name Matches" table. Same row as above minus the
    IconButton: a name rule matches by substring rather than identifying one
    item, so there is no item icon to show. The Name edit box takes over the
    space the icon used to occupy.

    Deliberately not built by inheriting the row above and hiding the icon -
    ScrollBox measures an element template once, and the two lists want
    different Name widths anyway.
  -->
  <Button name="AutoMailerNameRowTemplate" virtual="true">
    <Size x="280" y="26"/>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Stripe" setAllPoints="true">
          <Color r="1" g="1" b="1" a="0.05"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <!-- Anchored in Lua, for the same document-order reason as above. -->
        <FontString parentKey="RecipientHint" inherits="GameFontDisableSmall" justifyH="LEFT">
          <Size x="80" y="12"/>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <EditBox parentKey="Name" inherits="InputBoxTemplate" autoFocus="false">
        <Size x="114" y="20"/>
        <Anchors>
          <Anchor point="LEFT" x="10" y="0"/>
        </Anchors>
      </EditBox>
      <!-- How many matching items to leave in the bags instead of mailing (#78). -->
      <EditBox parentKey="Retain" inherits="InputBoxTemplate" autoFocus="false" numeric="true">
        <Size x="30" y="20"/>
        <Anchors>
          <Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="RIGHT" x="8" y="0"/>
        </Anchors>
      </EditBox>
      <EditBox parentKey="Recipient" inherits="InputBoxTemplate" autoFocus="false">
        <Size x="80" y="20"/>
        <Anchors>
          <Anchor point="LEFT" relativeKey="$parent.Retain" relativePoint="RIGHT" x="8" y="0"/>
        </Anchors>
      </EditBox>
      <Button parentKey="Delete">
        <Size x="16" y="16"/>
        <Anchors>
          <Anchor point="RIGHT" x="-6" y="0"/>
        </Anchors>
        <NormalTexture file="Interface\Buttons\UI-GroupLoot-Pass-Up"/>
        <PushedTexture file="Interface\Buttons\UI-GroupLoot-Pass-Down"/>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
      </Button>
    </Frames>
    <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD">
      <Color r="1" g="1" b="1" a="0.15"/>
    </HighlightTexture>
  </Button>
</Ui>
